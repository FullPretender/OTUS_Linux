global:
  scrape_interval: 10s
  evaluation_interval: 10s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

rule_files:
  - "alert_rules.yml"

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'nodes'
    static_configs:
      - targets:
          - '10.10.10.10:9100'
        labels:
          node: frontend
          role: frontend
      - targets:
          - '10.10.10.20:9100'
        labels:
          node: backend-1
          role: backend_master
      - targets:
          - '10.10.10.21:9100'
        labels:
          node: backend-2
          role: backend_slave
      - targets:
          - '10.10.10.30:9100'
        labels:
          node: monitoring
          role: monitoring
      - targets:
          - '10.10.10.40:9100'
        labels:
          node: logging
          role: logging
