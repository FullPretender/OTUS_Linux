#!/bin/bash
set -euo pipefail
export RESTIC_PASSWORD_FILE="/etc/restic_password"
RESTIC_REPO="{{ restic_repo_path }}"
DUMP_DIR="/tmp/mysql_backups"
DATE=$(date +%F_%T)
mkdir -p "$DUMP_DIR"

# Дамп БД с Slave (без блокировки Master)
mysqldump --defaults-file=/root/.my.cnf --single-transaction {{ db_wp_name }} > "$DUMP_DIR/wp_db_slave_${DATE}.sql"

# Инкрементальный бэкап Restic
restic backup --repo "$RESTIC_REPO" --tag backend_slave --exclude-caches \
  "$DUMP_DIR" \
  "{{ wp_dir }}/wp-content" \
  /etc/php/8.1 \
  /etc/mysql/conf.d \
  /etc/mysql/mysql.conf.d \
  /etc/nginx \
  >> /var/log/restic_backup_slave.log 2>&1

# Ротация снапшотов (7 дней, 4 недели)
restic forget --repo "$RESTIC_REPO" --keep-daily 7 --keep-weekly 4 --prune

# Очистка старых локальных дампов
find "$DUMP_DIR" -type f -name "*.sql" -mtime +1 -delete
