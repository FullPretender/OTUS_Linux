#!/bin/bash
set -euo pipefail
export RESTIC_PASSWORD_FILE="/etc/restic_password"
RESTIC_REPO="{{ restic_repo_path }}"
DUMP_DIR="/tmp/mysql_backups"
DATE=$(date +%F_%T)
mkdir -p "$DUMP_DIR"

# 1. Дамп БД (используем .my.cnf для безопасной авторизации)
mysqldump --defaults-file=/root/.my.cnf --single-transaction {{ db_wp_name }} > "$DUMP_DIR/wp_db_${DATE}.sql"

# 2. Инкрементальный бэкап Restic
restic backup --repo "$RESTIC_REPO" --tag backend_master --exclude-caches \
  "$DUMP_DIR" \
  "{{ wp_dir }}" \
  /etc/php/8.1 \
  /etc/mysql/conf.d \
  /etc/mysql/mysql.conf.d \
  /etc/nginx \
  >> /var/log/restic_backup_master.log 2>&1

# 3. Ротация снапшотов (7 дней, 4 недели)
restic forget --repo "$RESTIC_REPO" --keep-daily 7 --keep-weekly 4 --prune

# 4. Очистка старых локальных дампов
find "$DUMP_DIR" -type f -name "*.sql" -mtime +1 -delete
